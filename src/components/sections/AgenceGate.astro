---
/**
 * AgenceGate — fenêtre d'accueil de la page « Partenaires agences » (17/11/2026).
 * Deux choix de même poids : « Agence immobilière » (accès professionnel, ferme la fenêtre)
 * ou « Propriétaire » (prise de rendez-vous sur la page contact). Mention carte T en bas.
 * Choix non mémorisé : la fenêtre s'affiche à chaque visite.
 * Ce n'est pas une sécurité : le contenu reste dans la page (lisible par Google).
 * Version précédente (un bouton « Continuer » + lien « particulier ») : commit ba83544.
 */
import { getLocalizedPath } from '@i18n/index';
import type { AgencesLang } from '@/data/partenaires-agences';

interface Props { lang: AgencesLang; }
const { lang } = Astro.props;

const txt = {
  fr: {
    kicker: 'Espace professionnel',
    title: 'Réservé aux agences immobilières',
    proTag: 'Agence immobilière',
    proText: 'Soumettez un bien à valoriser et recevez notre dossier d’inspection.',
    proBtn: 'Accès professionnel',
    ownerTag: 'Propriétaire',
    ownerText: 'Vous vendez, achetez ou rénovez une villa ? Parlons de votre projet.',
    ownerBtn: 'Prendre rendez-vous',
    note: 'Accès réservé aux titulaires de la carte professionnelle (carte T).',
  },
  en: {
    kicker: 'Professional area',
    title: 'For real estate agencies',
    proTag: 'Estate agency',
    proText: 'Submit a property to enhance and receive our inspection report.',
    proBtn: 'Professional access',
    ownerTag: 'Owner',
    ownerText: 'Selling, buying or renovating a villa? Let’s talk about your project.',
    ownerBtn: 'Book a consultation',
    note: 'Access reserved for licensed estate agents (French carte T).',
  },
  it: {
    kicker: 'Area professionisti',
    title: 'Riservato alle agenzie immobiliari',
    proTag: 'Agenzia immobiliare',
    proText: 'Sottoponeteci un immobile da valorizzare e ricevete il nostro dossier di ispezione.',
    proBtn: 'Accesso professionisti',
    ownerTag: 'Proprietario',
    ownerText: 'Vendete, acquistate o ristrutturate una villa? Parliamo del vostro progetto.',
    ownerBtn: 'Prenota un appuntamento',
    note: 'Accesso riservato agli agenti immobiliari abilitati (carte T francese).',
  },
}[lang];
const contactHref = getLocalizedPath('/contact', lang);
const card = 'flex flex-col text-left bg-white border border-border px-5 py-5 sm:px-7 sm:py-8';
const tagCls = 'block font-heading text-[11px] font-semibold uppercase tracking-[0.2em] text-accent-brown mb-2 sm:mb-3';
const textCls = 'font-body text-sm sm:text-[15px] font-light text-[var(--color-text-light)] leading-[1.65] mb-4 sm:mb-7 flex-1';
const btnBase = 'w-full inline-flex items-center justify-center text-center gap-2 font-heading text-[11px] sm:text-xs font-semibold uppercase tracking-[0.16em] px-4 py-3.5 sm:py-4 transition-colors duration-base';
---

<div
  id="agence-gate"
  role="dialog"
  aria-modal="true"
  aria-labelledby="agence-gate-title"
  class="fixed inset-0 z-[2000] hidden justify-center bg-primary-dark/70 backdrop-blur-sm px-3 py-4 sm:px-4 sm:py-6 overflow-y-auto"
>
  <div class="w-full max-w-[760px] my-auto bg-primary-warm border border-accent-gold/30 shadow-2xl px-4 py-6 sm:px-10 sm:py-12">
    <div class="text-center mb-5 sm:mb-10">
      <span class="block font-heading text-[11px] font-semibold uppercase tracking-[0.25em] text-accent-gold mb-2 sm:mb-4">{txt.kicker}</span>
      <h2 id="agence-gate-title" class="font-display text-xl sm:text-3xl font-bold uppercase text-primary-dark leading-tight">{txt.title}</h2>
    </div>

    <div class="grid gap-3 sm:gap-5 sm:grid-cols-2">
      <div class={card}>
        <span class={tagCls}>{txt.proTag}</span>
        <p class={textCls}>{txt.proText}</p>
        <button type="button" id="agence-gate-ok" class={`${btnBase} bg-primary-dark text-white hover:bg-accent-brown`}>
          {txt.proBtn}&nbsp;→
        </button>
      </div>
      <div class={card}>
        <span class={tagCls}>{txt.ownerTag}</span>
        <p class={textCls}>{txt.ownerText}</p>
        <a href={contactHref} id="agence-gate-owner" class={`${btnBase} bg-accent-gold text-primary-dark hover:bg-accent-brown hover:text-white`}>
          {txt.ownerBtn}&nbsp;→
        </a>
      </div>
    </div>

    <p class="mt-4 sm:mt-7 text-center font-body text-[11px] sm:text-xs font-light text-[var(--color-text-light)]">{txt.note}</p>
  </div>
</div>

<script is:inline>
  (function () {
    // Choix non mémorisé : la fenêtre s'affiche à chaque visite.
    var gate = document.getElementById('agence-gate');
    if (!gate) return;
    // sortie du contenu de la page pour passer au-dessus du menu du site
    document.body.appendChild(gate);
    gate.classList.remove('hidden');
    gate.classList.add('flex');
    document.documentElement.style.overflow = 'hidden';
    var btn = document.getElementById('agence-gate-ok');
    btn.focus({ preventScroll: true });
    btn.addEventListener('click', function () {
      gate.classList.add('hidden');
      gate.classList.remove('flex');
      document.documentElement.style.overflow = '';
    });
    // garde le focus dans la fenêtre
    gate.addEventListener('keydown', function (e) {
      if (e.key !== 'Tab') return;
      var f = gate.querySelectorAll('button, a[href]');
      var first = f[0], last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    });
  })();
</script>
