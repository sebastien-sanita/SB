---
/**
 * AgenceForm — formulaire « Soumettre un bien » des pages partenaires agences (FR/EN/IT).
 *
 * Netlify Forms, formulaire `agence-var`, ENVOI NATIF (pas d'AJAX, pas de TrackingFields) :
 * un script côté client (Mail) lit la notification e-mail. Ne pas renommer les champs,
 * ne pas modifier le champ caché `subject` ni les `value` des options : ils sont lus tels quels.
 * Seuls les libellés visibles sont traduits. Détail : docs/formulaire-pipedrive.md.
 */
import { agencesContent, agencesEmail, agencesMerciPaths, type AgencesLang } from '@/data/partenaires-agences';

interface Props { lang: AgencesLang; }
const { lang } = Astro.props;
const f = agencesContent[lang].form;
const o = f.options;
const fx = f.fichiers;

// Valeurs envoyées (français, identiques dans les deux langues)
const typeBien = ['Villa', 'Appartement', 'Maison'] as const;
const etat = ['rafraichir', 'renover', 'lourd', 'bon'] as const;
const acquereur = ['non', 'oui'] as const;
const copropriete = ['oui', 'non'] as const;
const dpeClasses = ['A', 'B', 'C', 'D', 'E', 'F', 'G'];
const travaux = ['salle de bain', 'cuisine', 'climatisation', 'menuiseries', 'sols', 'électricité', 'redistribution'] as const;
const documents = ['dpe', 'diagnostics', 'plans', 'photos', 'reglement_copro', 'pv_ag', 'copro_fiche', 'urbanisme_anterieur', 'taxe_fonciere', 'factures_travaux'] as const;

const labelCls = 'block font-heading text-xs font-semibold text-accent-brown uppercase tracking-[0.15em] mb-3';
const inputCls = 'w-full px-4 py-3.5 border border-border bg-background font-body text-sm text-primary-dark placeholder:text-[var(--color-text-light)]/50 focus:outline-none focus:border-accent-gold transition-colors duration-300';
const selectCls = 'w-full px-4 py-3.5 border border-border bg-background font-body text-sm text-primary-dark focus:outline-none focus:border-accent-gold transition-colors duration-300';
const fileCls = 'block w-full font-body text-sm text-[var(--color-text-light)] file:mr-4 file:px-4 file:py-2.5 file:border file:border-solid file:border-border file:bg-primary-warm file:font-heading file:text-xs file:uppercase file:tracking-[0.1em] file:text-primary-dark file:cursor-pointer';
const legendCls = 'font-display text-lg font-semibold uppercase text-primary-dark mb-6';
const fieldsetCls = 'min-w-0 border-0 p-0 m-0';
const gridCls = 'grid grid-cols-1 sm:grid-cols-2 gap-6';
const checkLabelCls = 'flex items-start gap-3 font-body text-sm font-light text-primary-dark cursor-pointer';
const checkCls = 'mt-0.5 h-4 w-4 shrink-0 accent-[#C9A87C]';
const optionalCls = 'font-light normal-case tracking-normal text-[var(--color-text-light)]';
---

<form
  class="space-y-12"
  id="agence-form"
  data-msg-toomany={fx.tooMany}
  data-msg-notpdf={fx.notPdf}
  data-msg-total={fx.total}
  data-msg-toobig={fx.tooBig}
  data-msg-wait={fx.wait}
  data-email={agencesEmail}
  data-unit={lang === 'fr' ? 'Mo' : 'MB'}
  name="agence-var"
  method="POST"
  action={agencesMerciPaths[lang]}
  data-netlify="true"
  netlify-honeypot="bot-field"
  enctype="multipart/form-data"
>
  <input type="hidden" name="form-name" value="agence-var" />
  <input type="hidden" name="subject" value="[RS.D AGENCE] SB Design Var — Nouveau mandat" />
  <input type="hidden" name="travaux" id="travaux" value="" />
  <input type="hidden" name="documents" id="documents" value="" />
  <p class="hidden" aria-hidden="true">
    <label>{f.honeypot} <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
  </p>

  <fieldset class={fieldsetCls}>
    <legend class={legendCls}>{f.legendAgence}</legend>
    <div class={gridCls}>
      <div>
        <label for="agence" class={labelCls}>{f.agence}</label>
        <input type="text" id="agence" name="agence" required autocomplete="organization" class={inputCls} />
      </div>
      <div>
        <label for="agent" class={labelCls}>{f.agent}</label>
        <input type="text" id="agent" name="agent" required autocomplete="name" class={inputCls} />
      </div>
      <div>
        <label for="telephone" class={labelCls}>{f.telephone}</label>
        <input type="tel" id="telephone" name="telephone" required autocomplete="tel" class={inputCls} />
      </div>
      <div>
        <label for="email" class={labelCls}>{f.email}</label>
        <input type="email" id="email" name="email" required autocomplete="email" class={inputCls} />
      </div>
    </div>
  </fieldset>

  <fieldset class={fieldsetCls}>
    <legend class={legendCls}>{f.legendBien}</legend>
    <div class={gridCls}>
      <div class="sm:col-span-2">
        <label for="adresse" class={labelCls}>{f.adresse}</label>
        <input type="text" id="adresse" name="adresse" required class={inputCls} placeholder={f.adressePlaceholder} />
      </div>
      <div>
        <label for="type_bien" class={labelCls}>{f.typeBien}</label>
        <select id="type_bien" name="type_bien" class={selectCls}>
          {typeBien.map((v) => <option value={v}>{o.type_bien[v]}</option>)}
        </select>
      </div>
      <div>
        <label for="surface_m2" class={labelCls}>{f.surface}</label>
        <input type="text" id="surface_m2" name="surface_m2" inputmode="numeric" class={inputCls} />
      </div>
      <div>
        <label for="prix_affiche" class={labelCls}>{f.prix}</label>
        <input type="text" id="prix_affiche" name="prix_affiche" class={inputCls} />
      </div>
      <div>
        <label for="mois_en_vente" class={labelCls}>{f.mois}</label>
        <input type="text" id="mois_en_vente" name="mois_en_vente" inputmode="numeric" class={inputCls} />
      </div>
      <div>
        <label for="etat" class={labelCls}>{f.etat}</label>
        <select id="etat" name="etat" class={selectCls}>
          {etat.map((v) => <option value={v}>{o.etat[v]}</option>)}
        </select>
      </div>
      <div>
        <label for="acquereur" class={labelCls}>{f.acquereur}</label>
        <select id="acquereur" name="acquereur" class={selectCls}>
          {acquereur.map((v) => <option value={v}>{o.ouiNon[v]}</option>)}
        </select>
      </div>
      <div class="sm:col-span-2" role="group" aria-labelledby="travaux-label">
        <p id="travaux-label" class={labelCls}>{f.travaux}</p>
        <div id="cases" class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3">
          {travaux.map((v) => (
            <label class={checkLabelCls}><input type="checkbox" value={v} class={checkCls} /><span>{o.travaux[v]}</span></label>
          ))}
        </div>
      </div>
      <div class="sm:col-span-2">
        <label for="message" class={labelCls}>{f.message}</label>
        <textarea id="message" name="message" rows="4" class={`${inputCls} resize-none`}></textarea>
      </div>
    </div>
  </fieldset>

  <fieldset class={fieldsetCls}>
    <legend class={legendCls}>{f.legendAnalyse}</legend>
    <p class="font-body text-sm font-light text-[var(--color-text-light)] leading-[1.75] mb-8">{f.analyseIntro}</p>
    <div class={gridCls}>
      <div>
        <label for="dpe_numero" class={labelCls}>{f.dpeNumero}</label>
        <input type="text" id="dpe_numero" name="dpe_numero" maxlength="13" pattern={'[0-9A-Za-z]{13}'} title={f.dpeNumeroTitle} autocomplete="off" class={inputCls} placeholder={f.dpeNumeroPlaceholder} />
      </div>
      <div>
        <label for="dpe_classe" class={labelCls}>{f.dpeClasse}</label>
        <select id="dpe_classe" name="dpe_classe" class={selectCls}>
          <option value="">{o.dpeInconnu}</option>
          {dpeClasses.map((v) => <option value={v}>{v}</option>)}
        </select>
      </div>
      <div>
        <label for="etage" class={labelCls}>{f.etage}</label>
        <input type="text" id="etage" name="etage" inputmode="numeric" class={inputCls} />
      </div>
      <div>
        <label for="annee_construction" class={labelCls}>{f.annee}</label>
        <input type="text" id="annee_construction" name="annee_construction" inputmode="numeric" class={inputCls} />
      </div>
      <div>
        <label for="copropriete" class={labelCls}>{f.copropriete}</label>
        <select id="copropriete" name="copropriete" class={selectCls}>
          {copropriete.map((v) => <option value={v}>{o.ouiNon[v]}</option>)}
        </select>
      </div>
      <div class="sm:col-span-2" role="group" aria-labelledby="documents-label">
        <p id="documents-label" class={labelCls}>{f.documents}</p>
        <div id="docs" class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3">
          {documents.map((v) => (
            <label class={checkLabelCls}><input type="checkbox" value={v} class={checkCls} /><span>{o.documents[v]}</span></label>
          ))}
        </div>
      </div>
    </div>
  </fieldset>

  <!-- Pièces jointes : PDF pour les documents ; une seule zone photos (4 max), réduites dans le navigateur
       puis réparties dans photo1…photo4 (Netlify : un fichier par champ, 8 Mo par envoi). -->
  <fieldset class={fieldsetCls}>
    <legend class={legendCls}>{fx.legend}</legend>
    <p class="font-body text-sm font-light text-[var(--color-text-light)] leading-[1.75] mb-6 -mt-2">{fx.intro}</p>
    <div class={gridCls}>
      {fx.docs.map((d) => (
        <div>
          <label for={d.name} class={labelCls}>{d.label} <span class={optionalCls}>(PDF, {f.optional})</span></label>
          <input type="file" id={d.name} name={d.name} accept="application/pdf,.pdf" data-pdf class={fileCls} />
        </div>
      ))}
      <div class="sm:col-span-2">
        <label for="photos_choix" class={labelCls}>{fx.photos} <span class={optionalCls}>(JPG, {f.optional})</span></label>
        <p class="font-body text-sm font-light text-[var(--color-text-light)] mb-3">{fx.photosHint}</p>
        <input type="file" id="photos_choix" accept="image/jpeg,image/png,.jpg,.jpeg,.png" multiple class={fileCls} />
        {[1, 2, 3, 4].map((i) => (
          <input type="file" name={`photo${i}`} class="hidden" tabindex="-1" aria-hidden="true" />
        ))}
        <ul id="photos_liste" class="mt-3 space-y-1 font-body text-sm text-primary-dark"></ul>
      </div>
    </div>
    <p id="fichiers_total" class="font-body text-sm text-[var(--color-text-light)] mt-6" aria-live="polite"></p>
  </fieldset>

  <div>
    <button type="submit" class="inline-flex items-center justify-center px-8 py-4 bg-accent-gold text-white font-heading text-[15px] font-medium uppercase tracking-wider hover:bg-[#B8976B] transition-colors duration-500 w-full sm:w-auto">
      {f.submit}
    </button>
    <p class="font-body text-sm font-light text-[var(--color-text-light)] leading-[1.75] mt-6">
      {f.filesNote} <a href={`mailto:${agencesEmail}`} class="text-primary-dark underline underline-offset-4 decoration-accent-gold/60 hover:text-accent-brown transition-colors duration-300">{agencesEmail}</a>.
    </p>
  </div>
</form>

<!-- Cases cochées « travaux » et « documents » → champs cachés, jointes par « , » (script du modèle client) -->
<script is:inline>
  (function () {
    var form = document.getElementById('agence-form');
    if (!form) return;
    var joinChecked = function (id) {
      return Array.prototype.slice
        .call(document.querySelectorAll('#' + id + ' input:checked'))
        .map(function (c) { return c.value; })
        .join(', ');
    };
    form.addEventListener('submit', function () {
      document.getElementById('travaux').value = joinChecked('cases');
      document.getElementById('documents').value = joinChecked('docs');
      /* Témoin lu par la page de remerciement pour l'événement GTM `agence_lead`. */
      try { sessionStorage.setItem('rsd_agence_envoi', '1'); } catch (err) {}
    });
  })();
</script>

<!-- Fichiers : PDF seulement pour les documents, photos réduites (1600 px, JPG) et réparties dans photo1…photo4,
     total limité à 8 Mo (limite Netlify) : l'envoi est bloqué avec un message au-delà. -->
<script is:inline>
  (function () {
    var form = document.getElementById('agence-form');
    if (!form || !window.DataTransfer) return;
    var LIMIT = 8 * 1024 * 1024;
    var picker = document.getElementById('photos_choix');
    var slots = [1, 2, 3, 4].map(function (i) { return form.querySelector('input[name="photo' + i + '"]'); });
    var list = document.getElementById('photos_liste');
    var totalEl = document.getElementById('fichiers_total');
    var busy = false;
    var msg = function (k) { return form.getAttribute('data-msg-' + k); };
    var fr = form.getAttribute('data-unit') === 'Mo';
    var size = function (n) { return n < 1024 * 1024 ? Math.round(n / 1024) + (fr ? ' Ko' : ' KB') : (n / 1048576).toFixed(1).replace('.', fr ? ',' : '.') + (fr ? ' Mo' : ' MB'); };
    var total = function () {
      var t = 0;
      form.querySelectorAll('input[type="file"][name]').forEach(function (i) { for (var k = 0; k < i.files.length; k++) t += i.files[k].size; });
      return t;
    };
    var refresh = function () {
      var t = total();
      if (!t) { totalEl.textContent = ''; return; }
      totalEl.textContent = msg('total') + (fr ? '\u00a0: ' : ': ') + size(t) + ' / 8 ' + form.getAttribute('data-unit') + (t > LIMIT ? ' — ' + msg('toobig') + ' ' + form.getAttribute('data-email') + '.' : '');
      totalEl.style.color = t > LIMIT ? '#B4532A' : '';
    };
    var compress = function (file) {
      return new Promise(function (resolve) {
        if (!/^image\//.test(file.type)) return resolve(file);
        var url = URL.createObjectURL(file);
        var img = new Image();
        img.onload = function () {
          var k = Math.min(1, 1600 / Math.max(img.naturalWidth, img.naturalHeight));
          var c = document.createElement('canvas');
          c.width = Math.round(img.naturalWidth * k);
          c.height = Math.round(img.naturalHeight * k);
          c.getContext('2d').drawImage(img, 0, 0, c.width, c.height);
          URL.revokeObjectURL(url);
          c.toBlob(function (b) {
            if (!b || b.size >= file.size) return resolve(file);
            resolve(new File([b], file.name.replace(/\.[^.]+$/, '') + '.jpg', { type: 'image/jpeg' }));
          }, 'image/jpeg', 0.82);
        };
        img.onerror = function () { URL.revokeObjectURL(url); resolve(file); };
        img.src = url;
      });
    };
    picker.addEventListener('change', function () {
      var files = Array.prototype.slice.call(picker.files);
      var extra = files.length > 4;
      files = files.slice(0, 4);
      busy = true;
      list.innerHTML = '<li>' + msg('wait') + '</li>';
      Promise.all(files.map(compress)).then(function (out) {
        slots.forEach(function (slot, i) {
          var dt = new DataTransfer();
          if (out[i]) dt.items.add(out[i]);
          slot.files = dt.files;
        });
        list.innerHTML = '';
        out.forEach(function (f) {
          var li = document.createElement('li');
          li.textContent = '✓ ' + f.name + ' · ' + size(f.size);
          list.appendChild(li);
        });
        if (extra) {
          var li = document.createElement('li');
          li.textContent = msg('toomany');
          li.style.color = '#B4532A';
          list.appendChild(li);
        }
        busy = false;
        refresh();
      });
    });
    form.querySelectorAll('input[data-pdf]').forEach(function (input) {
      input.addEventListener('change', function () {
        var f = input.files[0];
        if (f && !/\.pdf$/i.test(f.name) && f.type !== 'application/pdf') {
          alert(msg('notpdf'));
          input.value = '';
        }
        refresh();
      });
    });
    form.addEventListener('submit', function (e) {
      if (busy || total() > LIMIT) {
        e.preventDefault();
        refresh();
        totalEl.scrollIntoView({ block: 'center' });
      }
    });
  })();
</script>
