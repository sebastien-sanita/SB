---
/**
 * ClimPage — gabarit de la page « Climatisation invisible en villa », en trois langues :
 * FR /climatisation-villa-var/, EN /en/air-conditioning-villa-var/, IT /it/climatizzazione-villa-var/.
 * Contenu : src/data/climatisation-villa.ts (maquette client du 12/11/2026, aucun prix).
 * Les valeurs envoyées par la liste des formules restent en français dans les trois langues.
 *
 * Formulaire de rappel : MÊME circuit que le formulaire de contact (Netlify Form `contact`,
 * envoi AJAX par src/scripts/contact-form.ts, champs cachés marque / pipeline / lang /
 * TrackingFields) avec `source_lead` = « Page climatisation ». Les `name` reprennent ceux du
 * contact : `lastname`, `phone`, `email`, `nature_travaux` (la formule), `code_postal`
 * (ville ou code postal), `message`. Détail : docs/formulaire-pipedrive.md.
 * Les id `contact-form`, `form-success` et `form-error` sont ceux attendus par le script.
 */
import Layout from '@layouts/Layout.astro';
import Section from '@components/ui/Section.astro';
import Container from '@components/ui/Container.astro';
import Button from '@components/ui/Button.astro';
import HeroInner from '@components/react/HeroInner';
import TrackingFields from '@components/TrackingFields.astro';
import type { Locale } from '@i18n/languages';
import { faqSchema } from '@utils/seo';
import { getLocalizedPath } from '@i18n/index';
import { climContentByLang, climPaths, climFormuleValues, type ClimLang } from '@/data/climatisation-villa';
import Picture from '@components/ui/Picture.astro';

/* Maillage : la page clim renvoie vers les 5 communes du Var (qui renvoient vers elle). */
const climCommunes = [
  ['/architecte-interieur-le-lavandou', 'Le Lavandou'],
  ['/architecte-interieur-bormes-les-mimosas', 'Bormes-les-Mimosas'],
  ['/architecte-interieur-rayol-canadel', 'Rayol-Canadel'],
  ['/architecte-interieur-sainte-maxime', 'Sainte-Maxime'],
  ['/architecte-interieur-ramatuelle', 'Ramatuelle'],
];
const climCommunesLabel: Record<ClimLang, string> = {
  fr: 'Nous intervenons notamment à',
  en: 'We work in particular in',
  it: 'Interveniamo in particolare a',
};
import publication from '@/data/publication.json';

interface Props { lang: ClimLang; }
const lang: Locale = Astro.props.lang;
const c = climContentByLang[Astro.props.lang];
const heroImage = '/images/projets/villa-azur-62.jpeg';

const h2 = 'font-display text-subsection font-bold uppercase text-primary-dark mt-4 mb-6';
const para = 'font-body text-base font-light text-[var(--color-text-light)] leading-[1.75]';
const small = 'font-body text-sm font-light text-[var(--color-text-light)] leading-[1.75]';
const h3 = 'font-display text-lg font-semibold uppercase text-primary-dark mb-2';
const tag = 'block font-heading text-[11px] font-semibold uppercase tracking-[0.2em] text-accent-brown mb-3';
const labelCls = 'block font-heading text-xs font-semibold text-accent-brown uppercase tracking-[0.15em] mb-3';
const inputCls = 'w-full px-4 py-3.5 border border-border bg-background font-body text-sm text-primary-dark placeholder:text-[var(--color-text-light)]/50 focus:outline-none focus:border-accent-gold transition-colors duration-300';
const selectCls = 'w-full px-4 py-3.5 border border-border bg-background font-body text-sm text-primary-dark focus:outline-none focus:border-accent-gold transition-colors duration-300';
const optionalCls = 'font-light normal-case tracking-normal text-[var(--color-text-light)]';
const anchor = 'scroll-mt-[calc(var(--header-h)+24px)]';
---

<Layout
  lang={lang}
  title={c.meta.title}
  description={c.meta.description}
  ogImage={heroImage}
  preloadImage={heroImage}
  schema={faqSchema(c.faq.items)}
  alternates={climPaths}
  noindex={!publication.agencesClimPubliees}
>

  <div class="-mt-[var(--header-h)]">
    <HeroInner
      client:load
      images={[heroImage]}
      imageAlt={c.hero.imageAlt}
      label={c.hero.label}
      title=""
      titlePrefix={c.hero.titlePrefix}
      titleMorphWords={c.hero.titleMorphWords}
      titleSizeClass="text-[clamp(28px,10vw,130px)]"
      subtitle={c.hero.subtitle}
    />
  </div>

  <!-- 01 — Quatre arguments -->
  <Section padding="md" background="white">
    <Container>
      <div class="max-w-3xl" data-reveal>
        <span class="subsection-number">01</span>
        <h2 class={h2}>
          {c.arguments.title1} <span class="font-display font-normal">{c.arguments.title2}</span>
        </h2>
        <p class={para}>{c.arguments.intro}</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-10 mt-12" data-reveal>
        {c.arguments.items.map((item) => (
          <div class="border-t border-border pt-5">
            <span class={tag}>{item.tag}</span>
            <h3 class={h3}>{item.title}</h3>
            <p class={small}>{item.text}</p>
          </div>
        ))}
      </div>
      <div class="flex flex-wrap gap-4 mt-12" data-reveal>
        <Button href="#etude" variant="primary" size="lg">{c.cta.etude}</Button>
        <Button href="#formules" variant="outline" size="lg">{c.cta.formules}</Button>
      </div>
    </Container>
  </Section>

  <!-- 02 — Quatre formules -->
  <Section padding="md" background="warm" id="formules" class={anchor}>
    <Container>
      <div class="max-w-3xl" data-reveal>
        <span class="subsection-number">02</span>
        <h2 class={h2}>
          {c.formules.title1} <span class="font-display font-normal">{c.formules.title2}</span>
        </h2>
        <p class={para}>{c.formules.intro}</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-10 mt-12" data-reveal>
        {c.formules.items.map((item) => (
          <div class="border-l border-accent-gold/40 pl-5">
            <span class={tag}>{item.tag}</span>
            <h3 class={h3}>{item.title}</h3>
            <p class={small}>{item.text}</p>
          </div>
        ))}
      </div>
    </Container>
  </Section>

  <!-- 03 — Cinq étapes -->
  <Section padding="md" background="white">
    <Container>
      <div class="max-w-3xl" data-reveal>
        <span class="subsection-number">03</span>
        <h2 class={h2}>
          {c.etapes.title1} <span class="font-display font-normal">{c.etapes.title2}</span>
        </h2>
      </div>
      <ol class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-10 mt-10" data-reveal>
        {c.etapes.steps.map((step, i) => (
          <li class="flex gap-5">
            <span class="font-heading text-sm font-medium text-accent-gold tracking-[0.15em] pt-1 shrink-0">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div>
              <h3 class={h3}>{step.title}</h3>
              <p class={small}>{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </Container>
  </Section>

  <!-- 04 — Sur nos chantiers : du gainable posé à la grille finie (photos client du 12/11/2026) -->
  <Section padding="md" background="dark">
    <Container>
      <div class="max-w-3xl" data-reveal>
        <span class="subsection-number">04</span>
        <h2 class="font-display text-subsection font-bold uppercase text-white mt-4 mb-6">
          {c.chantiers.title1} <span class="font-display font-normal">{c.chantiers.title2}</span>
        </h2>
        <p class="font-body text-base font-light text-white/70 leading-[1.75]">{c.chantiers.intro}</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-12 mt-12">
        {c.chantiers.items.map((item) => (
          <figure data-reveal>
            <div class="aspect-[4/3] overflow-hidden bg-white/5">
              <Picture src={item.src} alt={item.alt} class="w-full h-full object-cover" sizes="(max-width: 640px) 100vw, 50vw" />
            </div>
            <figcaption class="mt-4">
              <span class="block font-heading text-[11px] font-semibold uppercase tracking-[0.2em] text-accent-gold mb-2">{item.tag}</span>
              <span class="font-body text-sm font-light text-white/70 leading-[1.75]">{item.caption}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </Container>
  </Section>

  <!-- 05 — FAQ (schema FAQPage passé au Layout) -->
  <Section padding="md" background="warm">
    <Container>
      <div class="max-w-3xl" data-reveal>
        <span class="subsection-number">05</span>
        <h2 class={h2}>
          {c.faq.title1} <span class="font-display font-normal">{c.faq.title2}</span>
        </h2>
        <div class="divide-y divide-border">
          {c.faq.items.map((item) => (
            <div class="py-6">
              <h3 class="font-display text-lg font-semibold text-primary-dark mb-3">{item.q}</h3>
              <p class={para}>{item.a}</p>
            </div>
          ))}
        </div>
        <p class="font-body text-sm font-light text-[var(--color-text-light)] leading-[1.9] mt-8 pt-6 border-t border-border">
          {climCommunesLabel[Astro.props.lang]}{Astro.props.lang === 'fr' ? '\u00a0:' : ':'}{' '}
          {climCommunes.map(([path, name], i) => (
            <>
              <a href={getLocalizedPath(path, Astro.props.lang as Locale)} class="text-primary-dark underline underline-offset-4 decoration-accent-gold/60 hover:text-accent-brown transition-colors duration-300 whitespace-nowrap">{name}</a>{i < climCommunes.length - 1 ? ' · ' : '.'}
            </>
          ))}
        </p>
      </div>
    </Container>
  </Section>

  <!-- 06 — Formulaire de rappel (circuit du formulaire de contact) -->
  <Section padding="md" background="white" id="etude" class={anchor}>
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.3fr] gap-12 lg:gap-20">
        <div data-reveal>
          <span class="subsection-number">06</span>
          <h2 class={h2}>
            {c.form.title1} <span class="font-display font-normal">{c.form.title2}</span>
          </h2>
          <p class={para}>{c.form.intro}</p>
        </div>

        <div data-reveal data-reveal-delay="0.1">
          <form
            class="space-y-6"
            action="/"
            method="POST"
            id="contact-form"
            name="contact"
            data-netlify="true"
            netlify-honeypot="bot-field"
          >
            <input type="hidden" name="form-name" value="contact" />
            <input type="hidden" name="lang" value={lang} />
            <input type="hidden" name="marque" value="SB Design" />
            <input type="hidden" name="source_lead" value="Page climatisation" />
            <input type="hidden" name="pipeline" value="SB Design" />
            {/* Champs du formulaire contact non demandés ici. À GARDER : Netlify ne retient qu'une
                définition par nom de formulaire ; sans eux, la page Contact pourrait perdre ces champs. */}
            <input type="hidden" name="firstname" value="" />
            <input type="hidden" name="statut_propriete" value="" />
            <input type="hidden" name="budget_travaux" value="" />
            <input type="hidden" name="echeance" value="" />
            <p class="hidden" aria-hidden="true">
              <label>{c.form.honeypot} : <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
            </p>
            <TrackingFields />

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label for="lastname" class={labelCls}>{c.form.nom}</label>
                <input type="text" id="lastname" name="lastname" required autocomplete="name" class={inputCls} />
              </div>
              <div>
                <label for="phone" class={labelCls}>{c.form.telephone}</label>
                <input type="tel" id="phone" name="phone" required autocomplete="tel" class={inputCls} />
              </div>
            </div>

            <div>
              <label for="email" class={labelCls}>{c.form.email} <span class={optionalCls}>({c.form.optional})</span></label>
              <input type="email" id="email" name="email" autocomplete="email" class={inputCls} />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label for="nature_travaux" class={labelCls}>{c.form.formule}</label>
                <select id="nature_travaux" name="nature_travaux" required class={selectCls}>
                  <option value="">{c.form.selectDefault}</option>
                  {c.form.formules.map((v, i) => <option value={climFormuleValues[i]}>{v}</option>)}
                </select>
              </div>
              <div>
                <label for="code_postal" class={labelCls}>{c.form.ville}</label>
                <input type="text" id="code_postal" name="code_postal" autocomplete="address-level2" class={inputCls} placeholder={c.form.villePlaceholder} />
              </div>
            </div>

            <div>
              <label for="message" class={labelCls}>{c.form.message} <span class={optionalCls}>({c.form.optional})</span></label>
              <textarea id="message" name="message" rows="4" class={`${inputCls} resize-none`} placeholder={c.form.messagePlaceholder}></textarea>
            </div>

            <button type="submit" class="inline-flex items-center justify-center px-8 py-4 bg-accent-gold text-white font-heading text-[15px] font-medium uppercase tracking-wider hover:bg-[#B8976B] transition-colors duration-500 w-full sm:w-auto">
              {c.form.submit}
            </button>
          </form>

          <!-- Messages affichés par src/scripts/contact-form.ts -->
          <div id="form-success" class="hidden mt-8 p-6 bg-accent-gold/10 border border-accent-gold/30" role="status">
            <p class="font-body text-base text-primary-dark">{c.form.success}</p>
          </div>
          <div id="form-error" class="hidden mt-8 p-6 bg-red-50 border border-red-200" role="alert">
            <p class="font-body text-base text-primary-dark">{c.form.error} <a href="mailto:info@sbdesign.fr" class="underline underline-offset-4">info@sbdesign.fr</a>.</p>
          </div>
        </div>
      </div>
    </Container>
  </Section>

</Layout>

<script>
  import '@/scripts/contact-form';
</script>
