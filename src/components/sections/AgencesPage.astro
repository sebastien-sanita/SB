---
/**
 * AgencesPage — gabarit de la page « Partenaires agences » (FR : /partenaires-agences-var/,
 * EN : /en/real-estate-agents/). Contenu : src/data/partenaires-agences.ts.
 * Même facture que les pages locales (HeroInner, sections numérotées, listes à coche).
 * Trois langues : FR, EN et IT (/it/partner-agenzie-immobiliari/).
 */
import Layout from '@layouts/Layout.astro';
import Section from '@components/ui/Section.astro';
import Container from '@components/ui/Container.astro';
import Button from '@components/ui/Button.astro';
import HeroInner from '@components/react/HeroInner';
import AgenceForm from '@components/sections/AgenceForm.astro';
import AgenceGate from '@components/sections/AgenceGate.astro';
import { agencesContent, agencesPaths, agencesEmail, type AgencesLang } from '@/data/partenaires-agences';
import publication from '@/data/publication.json';

interface Props { lang: AgencesLang; }
const { lang } = Astro.props;
const c = agencesContent[lang];

const heroImage = '/images/projets/aiguebelle-6.jpeg';

const h2 = 'font-display text-subsection font-bold uppercase text-primary-dark mt-4 mb-6';
const para = 'font-body text-base font-light text-[var(--color-text-light)] leading-[1.75]';
const small = 'font-body text-sm font-light text-[var(--color-text-light)] leading-[1.75]';
const h3 = 'font-display text-lg font-semibold uppercase text-primary-dark mb-2';
const tag = 'block font-heading text-[11px] font-semibold uppercase tracking-[0.2em] text-accent-brown mb-3';
---

<Layout
  lang={lang}
  title={c.meta.title}
  description={c.meta.description}
  ogImage={heroImage}
  preloadImage={heroImage}
  alternates={agencesPaths}
  noindex={!publication.agencesClimPubliees}
>

  <AgenceGate lang={lang} />

  <div class="-mt-[var(--header-h)]">
    <HeroInner
      client:load
      images={[heroImage]}
      imageAlt={c.hero.imageAlt}
      label={c.hero.label}
      title=""
      titlePrefix={c.hero.titlePrefix}
      titleMorphWords={c.hero.titleMorphWords}
      titleSizeClass="text-[clamp(28px,10vw,130px)]"
      subtitle={c.hero.subtitle}
    />
  </div>

  <!-- 01 — Trois scénarios -->
  <Section padding="md" background="white">
    <Container>
      <div class="max-w-3xl" data-reveal>
        <span class="subsection-number">01</span>
        <h2 class={h2}>
          {c.scenarios.title1} <span class="font-heading font-light">{c.scenarios.title2}</span>
        </h2>
        <p class={para}>{c.scenarios.intro}</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-x-12 gap-y-10 mt-12" data-reveal>
        {c.scenarios.items.map((s) => (
          <div class="border-t border-accent-gold/40 pt-6">
            <span class={tag}>{c.scenarios.keyLabel} {s.key}</span>
            <h3 class={h3}>{s.title}</h3>
            <p class={small}>{s.text}</p>
            <p class="font-body text-sm text-primary-dark leading-[1.75] mt-4">{c.scenarios.quoteOpen}{s.quote}{c.scenarios.quoteClose}</p>
          </div>
        ))}
      </div>
      <div class="flex flex-wrap gap-4 mt-12" data-reveal>
        <Button href="#soumettre" variant="primary" size="lg">{c.cta.submit}</Button>
      </div>
    </Container>
  </Section>

  <!-- 02 — Premier avis sous 24 h / dossier 72 h après la visite (fond blanc : seul l'espace 04 est sur fond chaud) -->
  <Section padding="md" background="white" class="border-t border-border">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-x-20 gap-y-16">
        <div data-reveal>
          <span class="subsection-number">02</span>
          <h2 class={h2}>
            {c.avis.title1} <span class="font-heading font-light">{c.avis.title2}</span>
          </h2>
          <p class={`${para} mb-8`}>{c.avis.intro}</p>
          <ul class="space-y-3">
            {c.avis.items.map((item) => (
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-accent-gold mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 13l4 4L19 7" />
                </svg>
                <span class="font-body text-sm font-light text-[var(--color-text-light)]">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        <div data-reveal data-reveal-delay="0.1">
          <span class="subsection-number">03</span>
          <h2 class={h2}>
            {c.dossier.title1} <span class="font-heading font-light">{c.dossier.title2}</span>
          </h2>
          <p class={`${para} mb-8`}>{c.dossier.intro}</p>
          <ol class="space-y-8">
            {c.dossier.steps.map((step, i) => (
              <li class="flex gap-5">
                <span class="font-heading text-sm font-medium text-accent-gold tracking-[0.15em] pt-1 shrink-0">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <div>
                  <h3 class={h3}>{step.title}</h3>
                  <p class={small}>{step.text}</p>
                </div>
              </li>
            ))}
          </ol>
          <p class={`${small} mt-10`}>{c.dossier.note}</p>
        </div>
      </div>
    </Container>
  </Section>

  <!-- 04 — Espace « Soumettre un bien » : le seul point d'entrée (formulaire), mis en avant sur fond chaud.
       Colonne « À préparer » à gauche (collante sur ordinateur), formulaire dans un cadre blanc à droite. -->
  <Section id="soumettre" padding="md" background="warm" class="scroll-mt-[var(--header-h)] border-t border-accent-gold/30">
    <Container>
      <div class="max-w-3xl" data-reveal>
        <span class="subsection-number">04</span>
        <span class={`${tag} mt-4`}>{c.depot.kicker}</span>
        <h2 class={h2}>
          {c.depot.title1} <span class="font-heading font-light">{c.depot.title2}</span>
        </h2>
        <p class={para}>{c.depot.lead}</p>
      </div>

      <ol class="grid grid-cols-1 sm:grid-cols-3 gap-px bg-accent-gold/30 border border-accent-gold/30 mt-10 md:mt-12" data-reveal>
        {c.depot.steps.map((s, i) => (
          <li class="bg-primary-warm p-5 md:p-6">
            <div class="flex items-baseline gap-3">
              <span class="font-display text-2xl font-bold text-accent-gold leading-none [font-variant-numeric:lining-nums] relative -top-px">{String(i + 1).padStart(2, '0')}</span>
              <p class="font-display text-base font-semibold uppercase text-primary-dark leading-none">{s.title}</p>
            </div>
            <p class={`${small} mt-3`}>{s.text}</p>
          </li>
        ))}
      </ol>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 mt-10 md:mt-14">
        <aside class="lg:col-span-4">
          <div class="lg:sticky lg:top-[calc(var(--header-h)+24px)] border border-accent-gold/40 bg-background p-6 md:p-8">
            <p class="font-display text-lg font-semibold uppercase text-primary-dark mb-4">{c.depot.prepareTitle}</p>
            <ul class="space-y-3">
              {c.depot.prepare.map((x) => (
                <li class="flex gap-3 font-body text-sm text-primary-dark leading-[1.6]">
                  <span class="mt-[9px] h-px w-3 shrink-0 bg-accent-gold" aria-hidden="true"></span>{x}
                </li>
              ))}
            </ul>
            <p class={`${small} mt-5`}>{c.depot.prepareNote}</p>
            <p class="font-body text-sm text-primary-dark mt-6 pt-5 border-t border-border">
              {c.depot.question}{' '}
              <a href={`mailto:${agencesEmail}`} class="underline underline-offset-4 decoration-accent-gold/60 hover:text-accent-brown transition-colors duration-300">{agencesEmail}</a>
            </p>
          </div>
        </aside>
        <div class="lg:col-span-8 bg-background border border-border p-6 sm:p-8 md:p-12">
          <AgenceForm lang={lang} />
        </div>
      </div>
    </Container>
  </Section>

</Layout>
