---
/**
 * CommunePage — gabarit des pages « architecte d'intérieur + commune » (FR/EN/IT).
 * Contenu : src/data/communes/*.ts (modèle : src/data/communes/types.ts).
 * Même facture que les pages villes existantes (HeroInner, sections numérotées,
 * listes à coche, cartes projet, CTA sombre) + FAQ locale → schema FAQPage.
 */
import Layout from '@layouts/Layout.astro';
import Section from '@components/ui/Section.astro';
import Container from '@components/ui/Container.astro';
import Button from '@components/ui/Button.astro';
import Picture from '@components/ui/Picture.astro';
import HeroInner from '@components/react/HeroInner';
import { projects, type Project } from '@/data/projects';
import { getLocalizedPath } from '@i18n/index';
import type { Locale } from '@i18n/languages';
import type { Commune } from '@/data/communes/types';
import { faqSchema } from '@utils/seo';

interface Props {
  commune: Commune;
  lang: Locale;
}

const { commune, lang } = Astro.props;
const c = commune.content[lang];

const cards = c.realisations.cards
  .map(({ slug, alt }) => ({ project: projects.find((p) => p.slug === slug), alt }))
  .filter((x): x is { project: Project; alt: string } => Boolean(x.project));

const heroTitle = `${c.hero.titleLine1}<br /><span class="font-heading font-light text-[0.4em]">${c.hero.titleLine2}</span>`;

const h2 = 'font-display text-subsection font-bold uppercase text-primary-dark mt-4 mb-6';
const para = 'font-body text-base font-light text-[var(--color-text-light)] leading-[1.75]';
const h3 = 'font-display text-lg font-semibold uppercase text-primary-dark mb-2';
const cardsGrid = cards.length > 1 ? 'grid grid-cols-1 md:grid-cols-2 gap-3 md:gap-4' : 'grid grid-cols-1 gap-3 md:gap-4';
---

<Layout
  lang={lang}
  title={c.meta.title}
  description={c.meta.description}
  ogImage={commune.ogImage}
  preloadImage={commune.heroImages[0]}
  schema={faqSchema(c.faq.items)}
>

  <div class="-mt-[var(--header-h)]">
    <HeroInner
      client:load
      images={commune.heroImages}
      imageAlt={c.hero.imageAlt}
      label={c.hero.label}
      title={heroTitle}
      subtitle={c.hero.subtitle}
    />
  </div>

  <!-- 01 — La commune et ses quartiers -->
  <Section padding="lg" background="white">
    <Container>
      <div class="max-w-3xl" data-reveal>
        <span class="subsection-number">01</span>
        <h2 class={h2}>
          {c.commune.title1} <span class="font-heading font-light">{c.commune.title2}</span>
        </h2>
        <div class="space-y-5">
          {c.commune.paragraphs.map((text) => <p class={para}>{text}</p>)}
        </div>
      </div>
      <div class="mt-14" data-reveal>
        <h3 class="font-heading text-xs font-semibold text-accent-brown uppercase tracking-[0.15em] mb-8">
          {c.commune.quartiersTitle}
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-8">
          {c.commune.quartiers.map((q) => (
            <div class="border-l border-accent-gold/40 pl-5">
              <h4 class={h3}>{q.name}</h4>
              <p class="font-body text-sm font-light text-[var(--color-text-light)] leading-[1.75]">{q.text}</p>
            </div>
          ))}
        </div>
      </div>
    </Container>
  </Section>

  <!-- 02 — Types de biens et prestations -->
  <Section padding="lg" background="warm">
    <Container>
      <div class="max-w-3xl" data-reveal>
        <span class="subsection-number">02</span>
        <h2 class={h2}>
          {c.biens.title1} <span class="font-heading font-light">{c.biens.title2}</span>
        </h2>
        <div class="space-y-5 mb-8">
          {c.biens.paragraphs.map((text) => <p class={para}>{text}</p>)}
        </div>
        <ul class="space-y-3">
          {c.biens.items.map((item) => (
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent-gold mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 13l4 4L19 7" />
              </svg>
              <span class="font-body text-sm font-light text-[var(--color-text-light)]">{item}</span>
            </li>
          ))}
        </ul>
        <h3 class="font-heading text-xs font-semibold text-accent-brown uppercase tracking-[0.15em] mt-12 mb-5">
          {c.biens.prestationsTitle}
        </h3>
        <ul class="space-y-3">
          {c.biens.prestations.map((item) => (
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent-gold mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 13l4 4L19 7" />
              </svg>
              <span class="font-body text-sm font-light text-[var(--color-text-light)]">{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </Container>
  </Section>

  <!-- 03 — Contraintes locales -->
  <Section padding="lg" background="white">
    <Container>
      <div class="max-w-3xl" data-reveal>
        <span class="subsection-number">03</span>
        <h2 class={h2}>
          {c.contraintes.title1} <span class="font-heading font-light">{c.contraintes.title2}</span>
        </h2>
        <p class={para}>{c.contraintes.intro}</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-8 mt-12" data-reveal>
        {c.contraintes.items.map((item) => (
          <div class="border-t border-border pt-5">
            <h3 class={h3}>{item.title}</h3>
            <p class="font-body text-sm font-light text-[var(--color-text-light)] leading-[1.75]">{item.text}</p>
          </div>
        ))}
      </div>
      <p class="font-body text-sm italic font-light text-[var(--color-text-light)] leading-[1.75] mt-10 max-w-3xl" data-reveal>
        {c.contraintes.note}
      </p>
    </Container>
  </Section>

  <!-- 04 — Méthode pour les propriétaires non résidents -->
  <Section padding="lg" background="warm">
    <Container>
      <div class="max-w-3xl" data-reveal>
        <span class="subsection-number">04</span>
        <h2 class={h2}>
          {c.methode.title1} <span class="font-heading font-light">{c.methode.title2}</span>
        </h2>
        <p class={para}>{c.methode.intro}</p>
      </div>
      <ol class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-10 mt-12" data-reveal>
        {c.methode.steps.map((step, i) => (
          <li class="flex gap-5">
            <span class="font-heading text-sm font-medium text-accent-gold tracking-[0.15em] pt-1 shrink-0">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div>
              <h3 class={h3}>{step.title}</h3>
              <p class="font-body text-sm font-light text-[var(--color-text-light)] leading-[1.75]">{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </Container>
  </Section>

  <!-- 05 — Réalisations proches -->
  {cards.length > 0 && (
    <Section padding="lg" background="white">
      <Container>
        <div class="max-w-3xl mb-10" data-reveal>
          <span class="subsection-number">05</span>
          <h2 class={h2}>
            {c.realisations.title1} <span class="font-heading font-light">{c.realisations.title2}</span>
          </h2>
          <p class={para}>{c.realisations.intro}</p>
        </div>
        <div class={cardsGrid} data-reveal>
          {cards.map(({ project, alt }) => (
            <a
              href={getLocalizedPath(`/projets/${project.slug}`, lang)}
              class="group relative overflow-hidden block h-[300px] lg:h-[420px]"
            >
              <Picture
                src={project.coverImage}
                alt={alt}
                class="w-full h-full object-cover transition-transform duration-700 ease-smooth group-hover:scale-[1.06]"
                loading="lazy" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent group-hover:from-black/70 transition-all duration-500" />
              <div class="absolute bottom-0 left-0 right-0 p-6 md:p-8">
                <span class="text-[11px] font-heading font-medium text-accent-gold uppercase tracking-[0.15em]">
                  {project.location}
                </span>
                <h3 class="font-display text-2xl md:text-3xl font-semibold uppercase text-white mt-1">
                  {project.title}
                </h3>
              </div>
            </a>
          ))}
        </div>
      </Container>
    </Section>
  )}

  <!-- 06 — FAQ locale -->
  <Section padding="lg" background="warm">
    <Container>
      <div class="max-w-3xl" data-reveal>
        <span class="subsection-number">06</span>
        <h2 class={h2}>
          {c.faq.title1} <span class="font-heading font-light">{c.faq.title2}</span>
        </h2>
        <div class="divide-y divide-border">
          {c.faq.items.map((item) => (
            <div class="py-6">
              <h3 class="font-display text-lg font-semibold text-primary-dark mb-3">{item.q}</h3>
              <p class={para}>{item.a}</p>
            </div>
          ))}
        </div>
      </div>
    </Container>
  </Section>

  <!-- Secteurs voisins (maillage interne) -->
  <Section padding="sm" background="white">
    <Container>
      <div data-reveal>
        <h2 class="font-heading text-xs font-semibold text-accent-brown uppercase tracking-[0.15em] mb-5">
          {c.voisins.title}
        </h2>
        <ul class="flex flex-wrap gap-3">
          {c.voisins.links.map((link) => (
            <li>
              <a
                href={getLocalizedPath(link.path, lang)}
                class="inline-flex items-center px-5 py-2.5 border border-border font-heading text-xs uppercase tracking-[0.15em] text-primary-dark hover:border-accent-gold hover:text-accent-brown transition-colors duration-300"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </Container>
  </Section>

  <!-- 07 — CTA -->
  <Section background="dark" padding="lg">
    <Container>
      <div class="text-center max-w-2xl mx-auto" data-reveal>
        <h2 class="font-display text-section font-bold uppercase text-white mb-6">
          {c.cta.title1} <span class="font-heading font-light">{c.cta.title2}</span>
        </h2>
        <p class="font-body text-lg font-light text-white/70 mb-10 leading-relaxed">{c.cta.text}</p>
        <Button href={getLocalizedPath('/contact', lang)} variant="primary" size="lg">
          {c.cta.button}
        </Button>
      </div>
    </Container>
  </Section>

</Layout>
