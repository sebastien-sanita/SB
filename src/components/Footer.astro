---
/**
 * Footer — Noir corporate, style international luxe
 * Dans le flux par défaut (toujours atteignable) ; l'effet « reveal » (sticky
 * sous le contenu) est activé par Layout.astro sur desktop uniquement.
 * Background #1A1A1A avec textes blancs/or
 * i18n support
 */
import Container from '@components/ui/Container.astro';
import { t, getLocalizedPath, getLangFromUrl } from '@i18n/index';
import type { Locale } from '@i18n/languages';
import Picture from '@components/ui/Picture.astro';
import { zoneGroups, hubZones, zonesTitle } from '@/data/zones-intervention';
import publication from '@/data/publication.json';
import { climPaths, type ClimLang } from '@/data/climatisation-villa';
import { projects } from '@/data/projects';
const climFooterLabel: Record<ClimLang, string> = { fr: 'Climatisation invisible', en: 'Invisible air conditioning', it: 'Climatizzazione invisibile' };

interface Props { lang?: Locale; }
const lang = Astro.props.lang ?? getLangFromUrl(Astro.url);

// Intitulés des colonnes ajoutées le 17/11/2026 (pied de page en 5 colonnes : toutes les pages du site y figurent)
const footerLabels: Record<Locale, { savoirFaire: string; tousProjets: string; contact: string }> = {
  fr: { savoirFaire: 'Savoir-faire', tousProjets: 'Tous les projets', contact: 'Contact' },
  en: { savoirFaire: 'What we do', tousProjets: 'All projects', contact: 'Contact' },
  it: { savoirFaire: 'Servizi', tousProjets: 'Tutti i progetti', contact: 'Contatti' },
};
const L = footerLabels[lang];
const linkCls = 'text-white/60 hover:text-white transition-colors duration-fast block py-[6px]';
const titleCls = 'font-heading text-sm font-semibold uppercase tracking-[0.2em] text-accent-gold/80 mb-6';
// Page « Partenaires agences » (FR/EN/IT) : affichée seulement une fois publiée (publication.json).
const agencesLink: Partial<Record<Locale, { href: string; label: string }>> = {
  fr: { href: '/partenaires-agences-var/', label: 'Partenaires agences' },
  en: { href: '/en/real-estate-agents/', label: 'Estate agent partners' },
  it: { href: '/it/partner-agenzie-immobiliari/', label: 'Agenzie partner' },
};

// Zones d'intervention : secteurs en liste, puis communes par département
// (source unique partagée avec l'accueil : src/data/zones-intervention.ts)
---

<footer
  id="main-footer"
  class="bg-primary-dark text-white pt-20 md:pt-[120px] pb-16 md:pb-10 px-6 md:px-10 relative overflow-hidden"
>
  {/* Coins décoratifs SVG — style Aker */}
  <svg class="absolute top-6 left-6 w-8 h-8 text-white/[0.06]" viewBox="0 0 32 32" fill="currentColor">
    <path d="M0 0h10v1.5H1.5V10H0z" />
  </svg>
  <svg class="absolute top-6 right-6 w-8 h-8 text-white/[0.06]" viewBox="0 0 32 32" fill="currentColor">
    <path d="M32 0H22v1.5h8.5V10H32z" />
  </svg>
  <svg class="absolute bottom-6 left-6 w-8 h-8 text-white/[0.06]" viewBox="0 0 32 32" fill="currentColor">
    <path d="M0 32h10v-1.5H1.5V22H0z" />
  </svg>
  <svg class="absolute bottom-6 right-6 w-8 h-8 text-white/[0.06]" viewBox="0 0 32 32" fill="currentColor">
    <path d="M32 32H22v-1.5h8.5V22H32z" />
  </svg>

  <Container>

    {/* Grid 4 colonnes */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-[1.35fr_0.9fr_1fr_1.05fr_1.3fr] gap-14 lg:gap-12 xl:gap-10 mb-14 pb-12 md:mb-20 md:pb-16 border-b border-white/10">

      {/* Col 1 : Branding */}
      <div>
        <Picture src="/images/logo-sb.png" alt="SB Design Riviera" class="h-28 md:h-36 w-auto invert -mt-[38px] md:-mt-[49px] -mb-2 md:-mb-4" />
        <p class="text-[15px] leading-[1.8] text-white/60 max-w-xs">
          {t('footer', 'desc', lang)}
        </p>

        {/* Réseaux sociaux — cercles subtils */}
        <div class="flex gap-4 mt-8">
          <a
            href="https://www.linkedin.com/company/sbdesignriviera/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="w-10 h-10 rounded-full bg-white/[0.06] flex items-center justify-center hover:bg-accent-gold/20 hover:border-accent-gold transition-all duration-base border border-white/10"
          >
            <svg class="w-[18px] h-[18px] text-white/70" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
          <a
            href="https://www.instagram.com/sbdesignriviera/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
            class="w-10 h-10 rounded-full bg-white/[0.06] flex items-center justify-center hover:bg-accent-gold/20 hover:border-accent-gold transition-all duration-base border border-white/10"
          >
            <svg class="w-[18px] h-[18px] text-white/70" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
            </svg>
          </a>
        </div>

        {/* Contact (sous la marque) */}
        <h4 class={`${titleCls} mt-10`}>{L.contact}</h4>
        <ul class="space-y-3 text-white/60">
          <li>
            <a href="tel:+33609459245" class="hover:text-accent-gold transition-colors duration-fast">
              +33 6 09 45 92 45
            </a>
          </li>
          <li>
            <a href="mailto:info@sbdesign.fr" class="hover:text-accent-gold transition-colors duration-fast">
              info@sbdesign.fr
            </a>
          </li>
          <li>
            <address class="not-italic text-white/40 leading-relaxed mt-4" set:html={t('common', 'location', lang).replace('\n', '<br />')} />
          </li>
        </ul>
      </div>

      {/* Col 2 : Navigation */}
      <div>
        <h4 class={titleCls}>{t('footer', 'navTitle', lang)}</h4>
        <ul class="space-y-3">
          <li><a href={getLocalizedPath('/', lang)} class={linkCls}>{t('nav', 'accueil', lang)}</a></li>
          <li><a href={getLocalizedPath('/agence', lang)} class={linkCls}>{t('nav', 'agence', lang)}</a></li>
          <li><a href={getLocalizedPath('/a-propos', lang)} class={linkCls}>{t('nav', 'processus', lang)}</a></li>
          <li><a href={getLocalizedPath('/expertise', lang)} class={linkCls}>{t('nav', 'studio', lang)}</a></li>
          <li><a href={getLocalizedPath('/contact', lang)} class={linkCls}>{t('nav', 'contact', lang)}</a></li>
        </ul>
      </div>

      {/* Col 3 : Savoir-faire (types de projets, climatisation, agences) */}
      <div>
        <h4 class={titleCls}>{L.savoirFaire}</h4>
        <ul class="space-y-3">
          <li><a href={`${getLocalizedPath('/projets', lang)}?type=renovation`} class={linkCls}>{t('footer', 'renovation', lang)}</a></li>
          <li><a href={`${getLocalizedPath('/projets', lang)}?type=construction`} class={linkCls}>{t('footer', 'construction', lang)}</a></li>
          {climPaths[lang as ClimLang] && (
            <li><a href={climPaths[lang as ClimLang]} class={linkCls}>{climFooterLabel[lang as ClimLang]}</a></li>
          )}
          {publication.agencesClimPubliees && agencesLink[lang] && (
            <li><a href={agencesLink[lang]?.href} class={linkCls}>{agencesLink[lang]?.label}</a></li>
          )}
        </ul>
      </div>

      {/* Col 4 : Projets (chaque réalisation a sa page) */}
      <div>
        <h4 class={titleCls}>{t('footer', 'projetsTitle', lang)}</h4>
        <ul class="space-y-3">
          {projects.map((p) => (
            <li><a href={getLocalizedPath(`/projets/${p.slug}`, lang)} class={linkCls}>{p.title}</a></li>
          ))}
          <li><a href={getLocalizedPath('/projets', lang)} class="text-accent-gold/80 hover:text-accent-gold transition-colors duration-fast block py-[6px]">{L.tousProjets}&nbsp;→</a></li>
        </ul>
      </div>

      {/* Col 5 : Zones d'intervention (source : src/data/zones-intervention.ts) */}
      <div>
        <h4 class={titleCls}>{zonesTitle[lang]}</h4>
        <ul class="space-y-3">
          {hubZones.map((zone) => (
            <li><a href={getLocalizedPath(zone.path, lang)} class={linkCls}>{zone.label[lang]}</a></li>
          ))}
        </ul>
        <div class="mt-6 space-y-4">
          {zoneGroups.map((group) => (
            <p class="text-[14px] leading-[1.9] text-white/30">
              <span class="block font-heading text-[11px] font-semibold uppercase tracking-[0.2em] text-white/40 mb-1">{group.name[lang]}</span>
              {group.zones.filter((zone) => !zone.hub).map((zone, i) => (
                <Fragment>{i > 0 && <Fragment><span aria-hidden="true" class="ml-1.5 mr-0.5">·</span>{' '}</Fragment>}<a href={getLocalizedPath(zone.path, lang)} class="whitespace-nowrap text-white/60 hover:text-white transition-colors duration-fast">{zone.label[lang]}</a></Fragment>
              ))}
            </p>
          ))}
        </div>
      </div>
    </div>

    {/* Footer bottom */}
    <div class="flex flex-col md:flex-row justify-between items-center gap-5 md:gap-4 text-sm text-white/40">
      <p class="text-center md:text-left">&copy; {new Date().getFullYear()} SB Design Riviera. {t('footer', 'copyright', lang)}</p>
      <div class="flex items-center gap-4">
        <span class="text-white/40">{t('footer', 'mentions', lang)}</span>
        <span class="text-white/20">&bull;</span>
        <span class="text-white/40">{t('footer', 'confidentialite', lang)}</span>
      </div>
    </div>

  </Container>
</footer>
