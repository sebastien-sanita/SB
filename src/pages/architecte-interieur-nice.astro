---
/**
 * Page locale SEO — Architecte d'intérieur à Nice et Villefranche-sur-Mer (FR)
 * Cible : « architecte d'intérieur Nice » + communes de l'est de la Riviera.
 */
import Layout from '@layouts/Layout.astro';
import Section from '@components/ui/Section.astro';
import Container from '@components/ui/Container.astro';
import Button from '@components/ui/Button.astro';
import HeroInner from '@components/react/HeroInner';
import { projects } from '../data/projects';
import { getLocalizedPath } from '@i18n/index';
import type { Locale } from '@i18n/languages';

const lang: Locale = 'fr';
const project = projects.find((p) => p.slug === 'villa-villefranche-sur-mer');
const heroImages = (project?.images ?? [project?.coverImage ?? '/images/projets/villa-azur-11.jpeg']).slice(0, 3);

const prestations = [
  'Rénovation de villas et appartements haut de gamme',
  'Architecture et décoration d\'intérieur sur mesure',
  'Mobilier et agencements sur mesure',
  'Valorisation patrimoniale et mise en location premium',
];
---

<Layout
  lang={lang}
  title="Architecte d'intérieur Nice & Villefranche | SB Design"
  description="Architecte d'intérieur à Nice et Villefranche-sur-Mer : rénovation, décoration et valorisation de résidences haut de gamme sur la Riviera. SB Design Riviera."
  ogImage={project?.coverImage}
>

  <div class="-mt-[80px]">
    <HeroInner
      client:load
      images={heroImages}
      label="Nice · Villefranche-sur-Mer"
      title={`Architecte d'intérieur<br /><span class="font-heading font-light text-[0.4em]">à Nice et Villefranche-sur-Mer</span>`}
      subtitle="De Nice à Saint-Jean-Cap-Ferrat, SB Design Riviera valorise les résidences d'exception de la Riviera."
    />
  </div>

  <!-- 01 — Nice et sa Riviera -->
  <Section padding="lg" background="white">
    <Container>
      <div class="max-w-3xl" data-reveal>
        <span class="subsection-number">01</span>
        <h2 class="font-display text-subsection font-bold uppercase text-primary-dark mt-4 mb-6">
          Nice et sa Riviera, <span class="font-heading font-light">un patrimoine d'exception</span>
        </h2>
        <p class="font-body text-base font-light text-[var(--color-text-light)] leading-[1.75]">
          De la baie des Anges aux caps préservés, l'est de la Riviera concentre un patrimoine résidentiel rare —
          appartements haussmanniens, villas Belle Époque, résidences contemporaines vue mer. SB Design Riviera y
          accompagne propriétaires privés et investisseurs internationaux dans la conception, la rénovation et la
          valorisation de leurs biens, avec une exigence constante d'élégance et de pérennité.
        </p>
      </div>
    </Container>
  </Section>

  <!-- 02 — Nos prestations -->
  <Section padding="lg" background="warm">
    <Container>
      <div class="max-w-3xl" data-reveal>
        <span class="subsection-number">02</span>
        <h2 class="font-display text-subsection font-bold uppercase text-primary-dark mt-4 mb-6">
          Nos prestations <span class="font-heading font-light">sur la Riviera</span>
        </h2>
        <p class="font-body text-base font-light text-[var(--color-text-light)] leading-[1.75] mb-8">
          De la rénovation intégrale d'un appartement à la création de mobilier sur mesure, nous intervenons à
          chaque étape du projet : conception architecturale, sélection de matériaux nobles, coordination de
          chantier et livraison clé en main — un accompagnement complet, du premier croquis à la remise des clés.
        </p>
        <ul class="space-y-3">
          {prestations.map((item) => (
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-accent-gold mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 13l4 4L19 7" />
              </svg>
              <span class="font-body text-sm font-light text-[var(--color-text-light)]">{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </Container>
  </Section>

  <!-- 03 — De Nice au Cap-Ferrat -->
  <Section padding="lg" background="white">
    <Container>
      <div class="max-w-3xl" data-reveal>
        <span class="subsection-number">03</span>
        <h2 class="font-display text-subsection font-bold uppercase text-primary-dark mt-4 mb-6">
          De Nice <span class="font-heading font-light">au Cap-Ferrat</span>
        </h2>
        <p class="font-body text-base font-light text-[var(--color-text-light)] leading-[1.75]">
          Notre studio intervient à Nice, Villefranche-sur-Mer, Beaulieu-sur-Mer, Saint-Jean-Cap-Ferrat et Èze.
          Des collines niçoises aux presqu'îles les plus prisées de la Riviera, chaque projet est conçu pour
          sublimer le caractère du lieu — son architecture, ses perspectives sur la Méditerranée, sa lumière.
        </p>
      </div>
    </Container>
  </Section>

  <!-- 04 — Une réalisation sur la Riviera -->
  {project && (
    <Section padding="lg" background="warm">
      <Container>
        <div class="max-w-3xl mb-10" data-reveal>
          <h2 class="font-display text-subsection font-bold uppercase text-primary-dark">
            Une réalisation <span class="font-heading font-light">sur la Riviera</span>
          </h2>
        </div>
        <a
          href={getLocalizedPath(`/projets/${project.slug}`, lang)}
          class="group relative overflow-hidden block h-[320px] lg:h-[460px]"
          data-reveal
        >
          <img
            src={project.coverImage}
            alt={`Rénovation de villa à ${project.location}`}
            class="w-full h-full object-cover transition-transform duration-700 ease-smooth group-hover:scale-[1.05]"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent" />
          <div class="absolute bottom-0 left-0 right-0 p-6 md:p-8">
            <span class="text-[11px] font-heading font-medium text-accent-gold uppercase tracking-[0.15em]">
              {project.location}
            </span>
            <h3 class="font-display text-2xl md:text-3xl font-semibold uppercase text-white mt-1">
              {project.title}
            </h3>
          </div>
        </a>
      </Container>
    </Section>
  )}

  <!-- 05 — CTA -->
  <Section background="dark" padding="lg">
    <Container>
      <div class="text-center max-w-2xl mx-auto" data-reveal>
        <h2 class="font-display text-section font-bold uppercase text-white mb-6">
          Un projet à <span class="font-heading font-light">Nice ou sur la Riviera ?</span>
        </h2>
        <p class="font-body text-lg font-light text-white/70 mb-10 leading-relaxed">
          Échangeons sur votre projet de rénovation ou de valorisation. Consultation confidentielle et sans engagement.
        </p>
        <Button href={getLocalizedPath('/contact', lang)} variant="primary" size="lg">
          Prendre rendez-vous
        </Button>
      </div>
    </Container>
  </Section>

</Layout>
