---
/**
 * Layout principal — Shell HTML5 avec SEO, Header, Footer
 * + Page Loader, Page Border, GSAP/Lenis scripts
 */
import '@/styles/global.css';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import { getLangFromUrl, getHreflangAlternates, getBasePathname, getLocalizedPath } from '@i18n/utils';
import type { Locale } from '@i18n/languages';
import Picture from '@components/ui/Picture.astro';
import imageManifest from '@/data/image-manifest.json';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  class?: string;
  lang?: Locale;
  /** Image LCP (hero) à précharger en WebP responsive. */
  preloadImage?: string;
  /** Schema.org JSON-LD additionnel propre à la page (objet ou tableau). */
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const defaultDescriptions: Record<Locale, string> = {
  fr: "SB Design Riviera, architecte d'intérieur sur la Côte d'Azur : conception, rénovation et valorisation de résidences secondaires haut de gamme dans le Var et les Alpes-Maritimes.",
  en: "SB Design Riviera, interior architect on the French Riviera: design, renovation and enhancement of high-end second homes across the Var and Alpes-Maritimes.",
  it: "SB Design Riviera, architetto d'interni sulla Costa Azzurra: progettazione, ristrutturazione e valorizzazione di residenze secondarie di lusso nel Var e nelle Alpi Marittime.",
};

const currentLang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const {
  title,
  description = defaultDescriptions[currentLang],
  ogImage,
  class: className,
  preloadImage,
  schema,
} = Astro.props;

// Schema.org propre à la page → normalisé en tableau
const pageSchemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];

// Preload responsive WebP de l'image LCP (hero) si la page en fournit une
type ImgEntry = { w: number; h: number; widths: number[] };
let preloadSrcset: string | null = null;
if (preloadImage) {
  const e = (imageManifest as Record<string, ImgEntry>)[preloadImage];
  if (e) {
    const base = preloadImage.slice(0, preloadImage.lastIndexOf('.'));
    preloadSrcset = e.widths.map((w) => `${base}-${w}.webp ${w}w`).join(', ');
  }
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const hreflangAlternates = getHreflangAlternates(Astro.url.pathname, Astro.site?.toString().replace(/\/$/, '') ?? '');

// Open Graph — image absolue (fallback global si la page n'en fournit pas)
const ogImageURL = new URL(ogImage ?? '/images/projets/villa-azur-11.jpeg', Astro.site);
const ogLocales: Record<Locale, string> = { fr: 'fr_FR', en: 'en_GB', it: 'it_IT' };

// Schema.org BreadcrumbList — généré depuis le chemin de la page (Problème 5 SEO)
const siteBase = Astro.site?.toString().replace(/\/$/, '') ?? '';
const homeLabel: Record<Locale, string> = { fr: 'Accueil', en: 'Home', it: 'Home' };
const breadcrumbLabels: Record<string, Record<Locale, string>> = {
  projets: { fr: 'Projets', en: 'Projects', it: 'Progetti' },
  expertise: { fr: 'Expertise', en: 'Expertise', it: 'Competenze' },
  contact: { fr: 'Contact', en: 'Contact', it: 'Contatto' },
  'a-propos': { fr: 'À propos', en: 'About', it: 'Chi siamo' },
  agence: { fr: 'Agence', en: 'Agency', it: 'Agenzia' },
  'architecte-interieur-saint-tropez': {
    fr: "Architecte d'intérieur Saint-Tropez",
    en: 'Interior Architect Saint-Tropez',
    it: "Architetto d'interni Saint-Tropez",
  },
  'architecte-interieur-var': {
    fr: "Architecte d'intérieur Var",
    en: 'Interior Architect Var',
    it: "Architetto d'interni Var",
  },
  'architecte-interieur-nice': {
    fr: "Architecte d'intérieur Nice",
    en: 'Interior Architect Nice',
    it: "Architetto d'interni Nice",
  },
  'architecte-interieur-cannes': {
    fr: "Architecte d'intérieur Cannes",
    en: 'Interior Architect Cannes',
    it: "Architetto d'interni Cannes",
  },
  'architecte-interieur-antibes': {
    fr: "Architecte d'intérieur Antibes",
    en: 'Interior Architect Antibes',
    it: "Architetto d'interni Antibes",
  },
  'architecte-interieur-cap-ferrat': {
    fr: "Architecte d'intérieur Cap-Ferrat",
    en: 'Interior Architect Cap-Ferrat',
    it: "Architetto d'interni Cap-Ferrat",
  },
  'architecte-interieur-mougins': {
    fr: "Architecte d'intérieur Mougins",
    en: 'Interior Architect Mougins',
    it: "Architetto d'interni Mougins",
  },
  'architecte-interieur-le-lavandou': {
    fr: "Architecte d'intérieur Le Lavandou",
    en: 'Interior Architect Le Lavandou',
    it: "Architetto d'interni Le Lavandou",
  },
  'architecte-interieur-bormes-les-mimosas': {
    fr: "Architecte d'intérieur Bormes-les-Mimosas",
    en: 'Interior Architect Bormes-les-Mimosas',
    it: "Architetto d'interni Bormes-les-Mimosas",
  },
  'architecte-interieur-rayol-canadel': {
    fr: "Architecte d'intérieur Rayol-Canadel-sur-Mer",
    en: 'Interior Architect Rayol-Canadel-sur-Mer',
    it: "Architetto d'interni Rayol-Canadel-sur-Mer",
  },
  'architecte-interieur-sainte-maxime': {
    fr: "Architecte d'intérieur Sainte-Maxime",
    en: 'Interior Architect Sainte-Maxime',
    it: "Architetto d'interni Sainte-Maxime",
  },
  'architecte-interieur-ramatuelle': {
    fr: "Architecte d'intérieur Ramatuelle",
    en: 'Interior Architect Ramatuelle',
    it: "Architetto d'interni Ramatuelle",
  },
};
const titleCase = (s: string) =>
  s.split('-').map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');

const crumbSegments = getBasePathname(Astro.url.pathname).split('/').filter(Boolean);
const breadcrumbItems = [
  { name: homeLabel[currentLang], url: `${siteBase}${getLocalizedPath('/', currentLang)}` },
];
let crumbAcc = '';
for (const seg of crumbSegments) {
  crumbAcc += `/${seg}`;
  breadcrumbItems.push({
    name: breadcrumbLabels[seg]?.[currentLang] ?? titleCase(seg),
    url: `${siteBase}${getLocalizedPath(crumbAcc, currentLang)}/`,
  });
}
---

<!doctype html>
<html lang={currentLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/images/logo-sb.png" />
    <link rel="apple-touch-icon" href="/images/logo-sb.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- Révélations au scroll : l'état masqué (opacity:0) n'est appliqué que si JS est actif, et un filet de sécurité force l'affichage si les animations ne se sont pas initialisées. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        setTimeout(function () {
          if (d.classList.contains('reveals-ready')) return;
          // Le JS de la page n'a pas pris la main : on révèle le contenu et
          // on retire le rideau du loader, qui sinon masque toute la page.
          d.classList.add('reveal-fallback');
          var l = document.getElementById('page-loader');
          if (l) l.style.display = 'none';
          if (document.body) document.body.classList.remove('is-loading');
        }, 4000);
      })();
    </script>

    {/* Preload de l'image LCP (hero) — WebP responsive */}
    {preloadSrcset && (
      <link
        rel="preload"
        as="image"
        type="image/webp"
        imagesrcset={preloadSrcset}
        imagesizes="100vw"
        fetchpriority="high"
      />
    )}

    <!-- Tracking capture — runs BEFORE GTM so dataLayer is pre-populated -->
    <script is:inline>
      (function(){try{
        var K='sbd_tracking',N=Date.now(),SESSION_MS=30*60*1000;
        var PARAMS=['gclid','gbraid','wbraid','dclid','fbclid','msclkid','ttclid','li_fat_id','twclid','epik','irclickid','yclid','utm_source','utm_medium','utm_campaign','utm_term','utm_content','utm_id'];
        var s={};try{s=JSON.parse(localStorage.getItem(K))||{};}catch(e){}
        var u=new URL(location.href),q=u.searchParams;
        if(!s.first_seen_at)s.first_seen_at=N;
        if(!s.landing_page)s.landing_page=u.pathname+u.search;
        if(!s.page_referrer)s.page_referrer=document.referrer||'';
        if(!s.last_session_at||(N-s.last_session_at)>SESSION_MS)s.session_count=(s.session_count||0)+1;
        s.last_session_at=N;s.last_seen_at=N;s.page_views_count=(s.page_views_count||0)+1;
        PARAMS.forEach(function(k){var v=q.get(k);if(v){if(!s['first_'+k])s['first_'+k]=v;s['last_'+k]=v;s[k]=v;}});
        try{localStorage.setItem(K,JSON.stringify(s));}catch(e){}
        window.dataLayer=window.dataLayer||[];
        window.dataLayer.push({event:'tracking_ready',tracking:s});
      }catch(e){if(console&&console.error)console.error('[tracking-capture]',e);}})();
    </script>

    <!-- Google Tag Manager -->
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-MGLL3J66');
    </script>
    <!-- End Google Tag Manager -->

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL.href} />

    <!-- Hreflang alternates for i18n SEO -->
    {hreflangAlternates.map(({ lang, href }) => (
      <link rel="alternate" hreflang={lang} href={href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={hreflangAlternates.find(a => a.lang === 'fr')?.href ?? canonicalURL.href} />

    <!-- Schema.org LocalBusiness -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "@id": "https://www.sbdesign.fr/#business",
      "name": "SB Design Riviera",
      "alternateName": ["SB Design"],
      "description": "Architecte d'intérieur sur la Côte d'Azur : conception, rénovation et valorisation de résidences secondaires haut de gamme dans le Var et les Alpes-Maritimes.",
      "url": "https://www.sbdesign.fr",
      "logo": "https://www.sbdesign.fr/images/logo-sb.png",
      "image": "https://www.sbdesign.fr/images/projets/villa-azur-11.jpeg",
      "sameAs": [
        "https://www.instagram.com/sbdesignriviera/",
        "https://www.linkedin.com/company/sbdesignriviera/"
      ],
      "telephone": ["+33609459245"],
      "email": "info@sbdesign.fr",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Chassieu",
        "addressRegion": "Auvergne-Rhône-Alpes",
        "addressCountry": "FR"
      },
      "areaServed": [
        {"@type": "AdministrativeArea", "name": "Côte d'Azur"},
        {"@type": "AdministrativeArea", "name": "Var"},
        {"@type": "AdministrativeArea", "name": "Alpes-Maritimes"}
      ],
      "priceRange": "€€€€",
      "openingHours": "Mo-Fr 09:00-18:00",
      "knowsLanguage": ["fr", "en", "it"]
    })} />

    <!-- Schema.org BreadcrumbList -->
    {breadcrumbItems.length > 1 && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": breadcrumbItems.map((item, i) => ({
          "@type": "ListItem",
          "position": i + 1,
          "name": item.name,
          "item": item.url,
        })),
      })} />
    )}

    <!-- Schema.org spécifique à la page (CreativeWork, ItemList…) -->
    {pageSchemas.map((s) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(s)} />
    ))}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SB Design Riviera" />
    <meta property="og:locale" content={ogLocales[currentLang]} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL.href} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL.href} />

    <!-- Preload fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>

  <body class:list={['bg-background text-text-primary is-loading', className]}>

    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MGLL3J66" height="0" width="0" style="display:none;visibility:hidden"></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->

    <!-- Page Transition — Logo overlay -->
    <div
      id="page-loader"
      class="fixed inset-0 z-[9999] bg-background flex flex-col items-center justify-center pointer-events-none"
    >
      <div id="page-loader-logo" class="flex items-center justify-center">
        <Picture src="/images/logo-sb.png" alt="SB Design Riviera" class="h-28 md:h-32 w-auto" />
      </div>
      <div class="w-24 h-px bg-border overflow-hidden mt-8">
        <div
          id="page-loader-bar"
          class="w-full h-full bg-accent-gold origin-left"
          style="transform: scaleX(0);"
        ></div>
      </div>
    </div>

    <Header lang={currentLang} />

    <main>
      <slot />
    </main>

    <Footer lang={currentLang} />

    <!-- GSAP + Lenis + Animations -->
    <script>
      import '../scripts/lenis';
      import '../scripts/animations';
      import '../scripts/page-loader';

      // Footer reveal — sticky sous le contenu, uniquement sur desktop et si le footer
      // tient sous le header ; sinon footer dans le flux (mobile : toujours atteignable).
      function initFooterReveal() {
        const footer = document.getElementById('main-footer');
        const main = document.querySelector('main') as HTMLElement | null;
        if (!footer) return;
        if (main) main.style.marginBottom = '';
        footer.classList.remove('footer-reveal');
        const header = document.getElementById('main-nav');
        const headerH = header ? header.offsetHeight : 0;
        const isDesktop = window.matchMedia('(min-width: 1024px)').matches;
        const fits = footer.offsetHeight + headerH <= window.innerHeight;
        const reveal = isDesktop && fits;
        footer.classList.toggle('footer-reveal', reveal);
        // Page plus courte que l'écran : main occupe l'espace restant pour que le
        // footer sticky reste collé en bas (pas de bande claire sous le footer).
        if (main) {
          main.style.minHeight = reveal
            ? `${Math.max(0, window.innerHeight - footer.offsetHeight - main.offsetTop)}px`
            : '';
        }
      }
      initFooterReveal();
      window.addEventListener('load', initFooterReveal);
      window.addEventListener('resize', initFooterReveal);
    </script>
  </body>
</html>
